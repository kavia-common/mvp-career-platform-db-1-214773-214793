# Backend-specific environment variables for CareerPlatformBackendAPI
# Copy this file to .env for local development only. The application DOES NOT require
# a .env file at build time and will read environment variables provided at runtime.

# Application environment
APP_ENV=development

# Server port (used by entrypoint)
PORT=8000

# Authentication
JWT_SECRET=replace-with-a-strong-secret

# Database
# Example for PostgreSQL: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/career_platform_db

# Internal service-to-service token
INTERNAL_TOKEN=replace-with-internal-token
